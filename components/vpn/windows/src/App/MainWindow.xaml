<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlassVpn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassVpn.App"
    Title="Glass VPN">

    <Grid Padding="20,18,20,12" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- state and the power button -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Glass VPN" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StateText" Text="…" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="DetailText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="PowerButton" Grid.Column="1" Width="60" Height="60" CornerRadius="30" Padding="0"
                    Click="Power_Click" ToolTipService.ToolTip="Подключить или отключить">
                <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="24" />
            </Button>
        </Grid>

        <!-- traffic -->
        <Border Grid.Row="1" CornerRadius="8" Padding="14,10" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RxText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE898;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <!-- servers -->
            <Grid x:Name="ServersPanel" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Серверы" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="PingButton" HorizontalAlignment="Right" Padding="6,2"
                                     Content="Проверить задержку" Click="Ping_Click" />
                </Grid>
                <ListView x:Name="ServerList" Grid.Row="1" Margin="-12,0" SelectionMode="Single"
                          SelectionChanged="ServerList_SelectionChanged" KeyDown="ServerList_KeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ServerItem">
                            <Grid Padding="0,6" ColumnSpacing="8" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind DeleteText}" Click="Delete_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Latency}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Серверов пока нет. Нажмите «Добавить» и вставьте ссылку на подписку или ключ vless://" />
            </Grid>

            <!-- add a subscription or keys -->
            <StackPanel x:Name="AddPanel" Visibility="Collapsed" Spacing="10">
                <TextBlock Text="Подписка или ключи" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox x:Name="AddBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150"
                         PlaceholderText="https://… или vless://… — по одному в строке" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Отмена" Click="Back_Click" />
                    <Button x:Name="AddConfirm" Content="Добавить" Style="{StaticResource AccentButtonStyle}"
                            Click="AddConfirm_Click" />
                </StackPanel>
            </StackPanel>

            <!-- rules -->
            <Grid x:Name="RulesPanel" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="VpnOnlyBox" AcceptsReturn="True" TextWrapping="NoWrap"
                         Header="Только через VPN — программы (.exe) и сайты"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBox x:Name="DirectBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
                         Header="Всегда напрямую — программы (.exe)"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Отмена" Click="Back_Click" />
                    <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Click="RulesSave_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- actions -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Stretch" Padding="6,5" Click="Add_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Добавить" />
                </StackPanel>
            </Button>
            <Button x:Name="UpdateButton" Grid.Column="1" HorizontalAlignment="Stretch" Padding="6,5" Click="Update_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="6,5" Click="Rules_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock Text="Правила" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- messages and settings -->
        <StackPanel Grid.Row="4">
            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" Margin="0,0,0,6" />
            <ToggleSwitch x:Name="AutoSwitch" OnContent="Подключаться при запуске" OffContent="Подключаться при запуске" Toggled="Auto_Toggled" />
            <ToggleSwitch x:Name="FallbackSwitch" OnContent="Напрямую, если сервер недоступен" OffContent="Напрямую, если сервер недоступен" Toggled="Fallback_Toggled" />
        </StackPanel>
    </Grid>
</Window>
