         </entry>
diff --git a/src/shaders/glass.glsl b/src/shaders/glass.glsl
index 3b8cf50..a4a2122 100644
--- a/src/shaders/glass.glsl
+++ b/src/shaders/glass.glsl
@@ -68,6 +68,6 @@ void main(void)
         col = lgApplyHighlight(col, inside, outNorm, highlightWidth, highlightStrength);
     }
 
-    float mask = 1.0 - smoothstep(-3.0, 0.0, d);
