diff --git a/src/effect.cpp b/src/effect.cpp
index 03a4cb8..e3631c8 100644
--- a/src/effect.cpp
+++ b/src/effect.cpp
@@ -64,6 +64,13 @@ static void ensureResources()
 
 namespace KWin {
 
+static bool isPlasmaSurface(const KWin::EffectWindow* w)
+{
+    const QString cls = w->window()->resourceClass();
+    return cls == QStringLiteral("plasmashell") || cls == QStringLiteral("org.kde.plasmashell")
+        || cls == QStringLiteral("krunner") || cls == QStringLiteral("org.kde.krunner");
+}
+
 #if ACRYLIC_GLASS_KWIN_6_7
 /// 6.7 removed the global scaledRect() helper (it lived in
 /// effect/globals.h pre-6.7). Re-provide it verbatim so the three call
@@ -1238,7 +1245,11 @@ void BlurEffect::blur(
     // Maximized full-screen apps keep sharp corners unless the user
     // opts in via RoundCornersOfMaximizedWindows.
     const QMatrix4x4& colorMatrix = m_colorMatrix;
-    const float modulation = opacity * opacity;
+    // Inactive windows are faded by the Translucency effect; keep their
+    // glass at full strength so they turn into frosted glass instead of a
+    // see-through ghost. Closing/animating windows still fade normally.
+    const bool steadyInactive = !w->isDeleted() && effects->activeWindow() != w;
+    const float modulation = steadyInactive ? 1.0f : opacity * opacity;
 
     BorderRadius cornerRadius = w->window()->borderRadius();
     float topCornerRadius = 0.0;
@@ -1252,6 +1263,14 @@ void BlurEffect::blur(
         topCornerRadius = BlurConfig::popupCornerRadius();
         bottomCornerRadius = BlurConfig::popupCornerRadius();
 
+    } else if (!w->decoration() && isPlasmaSurface(w)) {
+        // Plasma's own popups, notifications and KRunner are normal windows
+        // without a decoration whose frame comes from the theme's
+        // dialogs/background; match its arc instead of the window radius,
+        // or the glass rim cuts across the corner and leaves a light wedge.
+        topCornerRadius = BlurConfig::plasmaCornerRadius();
+        bottomCornerRadius = BlurConfig::plasmaCornerRadius();
+
     } else {
         // A window is "maximized" when its frame fills the maximize area of
         // its own screen / desktop — checked live each frame (no cached
@@ -1307,12 +1326,18 @@ void BlurEffect::blur(
 
     const QVector2D halfpixel(0.5 / read->colorAttachment()->width(), 0.5 / read->colorAttachment()->height());
 
-    const QRectF transformedRect = QRectF {
-        w->frameGeometry().x() + data.xTranslation(),
-        w->frameGeometry().y() + data.yTranslation(),
-        w->frameGeometry().width() * data.xScale(),
-        w->frameGeometry().height() * data.yScale(),
-    };
+    // Undecorated surfaces (Plasma applet popups, menus, tooltips) ask for a
+    // blur region that is inset from their window geometry (shadow/margin
+    // area). Shape the glass to that region, otherwise it sticks out past
+    // the visible background and shows as a light rim at the corners.
+    const QRectF transformedRect = w->decoration()
+        ? QRectF {
+              w->frameGeometry().x() + data.xTranslation(),
+              w->frameGeometry().y() + data.yTranslation(),
+              w->frameGeometry().width() * data.xScale(),
+              w->frameGeometry().height() * data.yScale(),
+          }
+        : QRectF(backgroundRect);
     // Floor to integer device pixels so the SDF rounded corners are always
     // pixel-aligned — prevents subpixel border artifacts that shift with
     // window position.
diff --git a/src/glass.kcfg b/src/glass.kcfg
