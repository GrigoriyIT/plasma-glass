[Unit]
Description=Google Drive (rclone mount at ~/GoogleDrive)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
    --vfs-cache-mode full \
    --vfs-cache-max-size 10G \
    --vfs-cache-max-age 720h \
    --dir-cache-time 1h \
    --poll-interval 1m \
    --drive-export-formats docx,xlsx,pptx,svg \
    --umask 077 \
    --log-level NOTICE
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
